# Copy to .env and adjust. .env is git-ignored.

# --- limits ---
SBX_MEMORY=4g
SBX_CPUS=2
SBX_PIDS=1024

# --- model backend (pick ONE) ---
# 1) Local vllm server on the host (default) — same setup as ~/claude.sh,
#    but via the bridge gateway. Needs SBX_HOST_PORTS=8000 below and the
#    allowlist entry 172.28.0.1:8000 (in allowlist.default).
SBX_MODEL_BASE_URL=http://172.28.0.1:8000/
SBX_MODEL_API_KEY=vllm
SBX_MODEL_NAME=qwen
# Optional tuning (defaults in run-sandbox.sh match ~/claude.sh):
SBX_EFFORT_LEVEL=medium   # vllm accepts xhigh/medium/low, NOT "high"
# SBX_MAX_CONTEXT_TOKENS=100000
# SBX_MAX_OUTPUT_TOKENS=8192
# SBX_AUTO_COMPACT_WINDOW=95000

# 2) Real Anthropic API instead — comment out the vllm lines above and set:
# ANTHROPIC_API_KEY=sk-ant-...

# --- host isolation ---
# 1 = install sudo iptables host-isolation rules (default), 0 = skip
HOST_ISOLATION=1
# Comma-separated tcp ports on the host (via 172.28.0.1) the sandbox may reach.
# Pair each with an allowlist entry, e.g. 172.28.0.1:8000 for the local
# OpenAI-compatible model server.
SBX_HOST_PORTS=8000
