# Copy to .env and adjust. .env is git-ignored.

# --- limits (apply to both usecases) ---
SBX_MEMORY=4g
SBX_CPUS=2
# Wrapper fallback when unset here: 1024 (code), 2048 (pentest — nmap &
# parallel scanners fork many threads). A value set here always wins.
SBX_PIDS=1024

# --- model backend ---
# The sandbox reuses the host's Claude Code model config, so there is nothing
# to duplicate here: same model, effort, context and key, with only the
# loopback base URL rewritten to the bridge gateway (172.28.0.1). The
# gateway port is parsed from the base URL and allowlisted/iptables-allowed
# automatically. To use the real Anthropic API, change the host config (or
# point SBX_CLAUDE_CONFIG elsewhere / unset it and set ANTHROPIC_API_KEY).
# SBX_CLAUDE_CONFIG=$HOME/claude.sh

# --- network egress ---
# 1 = open egress (proxy logs everything but bypasses the allowlist),
# 0 = allowlist enforced. Wrapper defaults: code=1 (open), pentest=0.
# A value set here always wins over the wrapper default.
# SBX_OPEN_NETWORK=1

# --- host isolation ---
# 1 = install sudo iptables host-isolation rules (default), 0 = skip
HOST_ISOLATION=1
# Comma-separated tcp ports on the host (via 172.28.0.1) the sandbox may reach.
# Pair each with an allowlist entry, e.g. 172.28.0.1:8000 for the local
# OpenAI-compatible model server.
SBX_HOST_PORTS=8000
