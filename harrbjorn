#!/usr/bin/env bash
# harrbjorn — CLI-inngangen til harrbjorn-sandboxen.
#
# Usage:
#   harrbjorn code <args>        kodeagent-sandbox (run-code.sh)
#   harrbjorn security <args>    sikkerhetstest-sandbox (run-pentest.sh)
#
#   <args> går uendret til usecase-wrapperen (se `run-code.sh -h` /
#   `run-pentest.sh -h`); workdir er cwd med mindre -w gis. Med ingen
#   kommando åpnes en interaktiv bash i workdir.
#
# PATH (ingen installasjon): symlinke denne filen inn i en mappe som
# allerede ligger i PATH, eller legg repo-rotten i PATH.
#
# Autocomplete (bash, i ~/.bashrc):
#   eval "$(harrbjorn completion)"
#
# Eksempler:
#   harrbjorn code                               # interaktiv bash i cwd (default)
#   harrbjorn code claude                        # interaktiv claude i cwd
#   harrbjorn security -a 10.0.0.5:8080 claude -p "Test målet"
#   harrbjorn code -p 127.0.0.1:4321 claude      # eksterne proxy (Burp); CA auto-installas

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '2,22p' "$0"; exit "${1:-0}"; }

# Autocomplete (bash): fullfører subkommandoene (code, security) og
# usecase-flaggene (-w -a -H -f -p --rebuild). Eval-eres fra ~/.bashrc:
#   eval "$(harrbjorn completion)"
completion() {
  cat <<'EOF'
_harrbjorn() {
  local cur cmd
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  cmd="${COMP_WORDS[1]:-}"
  if (( COMP_CWORD == 1 )); then
    COMPREPLY=($(compgen -W "code security help completion" -- "$cur"))
  elif [[ "$cmd" == code || "$cmd" == security ]] && [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "-w -a -H -f -p --rebuild --help -- -" -- "$cur"))
  fi
  return 0
}
complete -F _harrbjorn harrbjorn
EOF
}

[[ $# -gt 0 ]] || usage 0
case "$1" in
  code)     shift; exec "$SCRIPT_DIR/run-code.sh" "$@" ;;
  security) shift; exec "$SCRIPT_DIR/run-pentest.sh" "$@" ;;
  completion) completion ;;
  help|-h|--help) usage 0 ;;
  *) echo "error: unknown subcommand: $1" >&2; usage 1 ;;
esac
